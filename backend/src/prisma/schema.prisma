// backend/src/prisma/schema.prisma
// Banco de dados relacional do Agendô

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Perfil {
  PACIENTE
  PROFISSIONAL
}

enum Especialidade {
  PSICOLOGIA_CLINICA
  PSIQUIATRIA
  TCC
  PSICANALISE
  FAMILIAR
  INFANTIL
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  REALIZADO
  CANCELADO
  REMARCADO
}

enum TipoSessao {
  AVALIACAO_INICIAL
  ACOMPANHAMENTO
  TCC
  PSICANALISE
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
}

enum MetodoPagamento {
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  CONVENIO
}

enum CanalNotificacao {
  EMAIL
  SMS
  PUSH
}

enum StatusNotificacao {
  AGENDADA
  ENVIADA
  FALHOU
}

enum AcaoProntuario {
  LEITURA
  CRIACAO
  EDICAO
  NEGADO
}

enum RecursoProntuario {
  PRONTUARIO
  ANOTACAO_PESSOAL
}

// Motivo interno de um acesso NEGADO: fica só no log, nunca vai para o cliente
enum MotivoNegado {
  PERFIL_NAO_PERMITIDO
  ENTRADA_INVALIDA
  SEM_VINCULO
  SEM_CONSENTIMENTO
  NAO_ENCONTRADO
  VERSAO_DESATUALIZADA
  FALHA_INTEGRIDADE
}

// Valores a confirmar pelo grupo com o professor (base legal do tratamento)
enum BaseLegal {
  CONSENTIMENTO
  TUTELA_SAUDE
}

// ─────────────────────────────────────────
// Entidades principais
// ─────────────────────────────────────────

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  telefone     String?
  cpf          String   @unique
  perfil       Perfil
  emailVerificado Boolean @default(false) @map("email_verificado")
  fotoPerfil   String?  @map("foto_perfil")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  paciente      Paciente?
  profissional  Profissional?
  notificacoes  Notificacao[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String   @map("usuario_id")
  expiresAt DateTime @map("expires_at")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Paciente {
  id               String   @id @default(uuid())
  usuarioId        String   @unique @map("usuario_id")
  dataNascimento   DateTime? @map("data_nascimento")
  planoSaude       String?  @map("plano_saude")
  numeroCarteirinha String?  @map("numero_carteirinha")
  observacoes      String?
  criadoEm         DateTime @default(now()) @map("criado_em")

  usuario           Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos      Agendamento[]
  pagamentos        Pagamento[]
  prontuarios       Prontuario[]
  avaliacoes        Avaliacao[]
  vinculos          Vinculo[]
  consentimentos    Consentimento[]
  anotacoesPessoais AnotacaoPessoal[]

  @@map("pacientes")
}

model Profissional {
  id              String        @id @default(uuid())
  usuarioId       String        @unique @map("usuario_id")
  crp             String        @unique
  especialidade   Especialidade
  valorSessao     Decimal       @map("valor_sessao") @db.Decimal(10, 2)
  duracaoPadrao   Int           @default(50) @map("duracao_padrao_min")
  bio             String?
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now()) @map("criado_em")

  usuario           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  disponibilidades  Disponibilidade[]
  agendamentos      Agendamento[]
  prontuarios       Prontuario[]
  avaliacoes        Avaliacao[]
  versoesAutoradas  ProntuarioVersao[]
  vinculos          Vinculo[]
  anotacoesPessoais AnotacaoPessoal[]

  @@map("profissionais")
}

model Disponibilidade {
  id              String    @id @default(uuid())
  profissionalId  String    @map("profissional_id")
  diaSemana       DiaSemana @map("dia_semana")
  horaInicio      String    @map("hora_inicio") // "08:00"
  horaFim         String    @map("hora_fim")    // "18:00"
  ativo           Boolean   @default(true)

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@map("disponibilidades")
}

model Agendamento {
  id              String            @id @default(uuid())
  pacienteId      String            @map("paciente_id")
  profissionalId  String            @map("profissional_id")
  pagamentoId     String?           @unique @map("pagamento_id")
  dataHora        DateTime          @map("data_hora")
  duracaoMin      Int               @default(50) @map("duracao_min")
  status          StatusAgendamento @default(PENDENTE)
  tipoSessao      TipoSessao        @map("tipo_sessao")
  observacoes     String?
  criadoEm        DateTime          @default(now()) @map("criado_em")
  atualizadoEm    DateTime          @updatedAt @map("atualizado_em")

  paciente      Paciente      @relation(fields: [pacienteId], references: [id])
  profissional  Profissional  @relation(fields: [profissionalId], references: [id])
  pagamento     Pagamento?    @relation(fields: [pagamentoId], references: [id])
  prontuario    Prontuario?
  notificacoes  Notificacao[]
  avaliacao     Avaliacao?

  @@map("agendamentos")
}

// ─────────────────────────────────────────
// Prontuário: ids e ponteiro em uma tabela, conteúdo cifrado em outra
// ─────────────────────────────────────────

// Só ids e o número da versão atual. Nenhum texto clínico.
// O id é gerado no código (crypto.randomUUID) porque entra no AAD antes do INSERT.
model Prontuario {
  id              String   @id
  agendamentoId   String   @unique @map("agendamento_id")
  profissionalId  String   @map("profissional_id")
  pacienteId      String   @map("paciente_id")
  versaoAtual     Int      @map("versao_atual")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  agendamento  Agendamento        @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  profissional Profissional       @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  paciente     Paciente           @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  versoes      ProntuarioVersao[]

  @@index([pacienteId, profissionalId])
  @@map("prontuarios")
}

// Só inserção: editar cria uma linha nova com numero + 1, nunca sobrescreve.
model ProntuarioVersao {
  id              String   @id @default(uuid())
  prontuarioId    String   @map("prontuario_id")
  numero          Int
  conteudoCifrado Bytes    @map("conteudo_cifrado") // JSON { v, anotacoes, cid, lembretes } cifrado
  iv              Bytes                             // 12 bytes, aleatório por versão
  authTag         Bytes    @map("auth_tag")         // 16 bytes
  chaveId         Int      @default(1) @map("chave_id")
  autorId         String   @map("autor_id")         // Profissional.id
  criadoEm        DateTime @default(now()) @map("criado_em")

  prontuario Prontuario   @relation(fields: [prontuarioId], references: [id], onDelete: Restrict)
  autor      Profissional @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@unique([prontuarioId, numero])
  @@map("prontuario_versoes")
}

// Anotações pessoais do psicólogo: cifradas, separadas, nunca expostas ao paciente.
// Só inserção: "editar" cria uma linha nova que aponta para a substituída.
// O id é gerado no código porque entra no AAD.
model AnotacaoPessoal {
  id              String   @id
  profissionalId  String   @map("profissional_id")
  pacienteId      String   @map("paciente_id")
  substituiId     String?  @unique @map("substitui_id") // cada anotação só pode ser substituída uma vez
  conteudoCifrado Bytes    @map("conteudo_cifrado")
  iv              Bytes
  authTag         Bytes    @map("auth_tag")
  chaveId         Int      @default(1) @map("chave_id")
  criadoEm        DateTime @default(now()) @map("criado_em")

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  paciente     Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  // Auto-relacionamento: a anotação nova aponta para a que ela substitui.
  substitui      AnotacaoPessoal? @relation("SubstituicaoAnotacao", fields: [substituiId], references: [id], onDelete: Restrict)
  substituidaPor AnotacaoPessoal? @relation("SubstituicaoAnotacao")

  @@index([profissionalId, pacienteId])
  @@map("anotacoes_pessoais")
}

// Vínculo profissional ↔ paciente. Nasce quando o profissional confirma a primeira consulta.
// Ativo = inicioEm <= agora e (fimEm nulo ou no futuro).
model Vinculo {
  id              String    @id @default(uuid())
  profissionalId  String    @map("profissional_id")
  pacienteId      String    @map("paciente_id")
  inicioEm        DateTime  @default(now()) @map("inicio_em")
  fimEm           DateTime? @map("fim_em")
  criadoEm        DateTime  @default(now()) @map("criado_em")

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Restrict)
  paciente     Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  @@index([profissionalId, pacienteId])
  @@map("vinculos")
}

// Consentimento por paciente. finalidade e baseLegal vêm da configuração do servidor, nunca do cliente.
model Consentimento {
  id          String    @id @default(uuid())
  pacienteId  String    @map("paciente_id")
  versaoTermo String    @map("versao_termo")
  finalidade  String
  baseLegal   BaseLegal @map("base_legal")
  aceitoEm    DateTime  @default(now()) @map("aceito_em")
  ip          String
  revogadoEm  DateTime? @map("revogado_em")

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  @@index([pacienteId, aceitoEm])
  @@map("consentimentos")
}

// Só inserção. Sem conteúdo clínico.
// Sem chaves estrangeiras de propósito: o log sobrevive a qualquer outro registro.
model LogAcessoProntuario {
  id           String            @id @default(uuid())
  usuarioId    String            @map("usuario_id")
  perfil       Perfil
  acao         AcaoProntuario
  recurso      RecursoProntuario
  motivo       MotivoNegado?     // preenchido só quando acao = NEGADO
  pacienteId   String?           @map("paciente_id")
  prontuarioId String?           @map("prontuario_id")
  ip           String?
  ocorridoEm   DateTime          @default(now()) @map("ocorrido_em")

  @@index([pacienteId, ocorridoEm])
  @@index([usuarioId, ocorridoEm])
  @@map("logs_acesso_prontuario")
}

// ─────────────────────────────────────────
// Demais entidades
// ─────────────────────────────────────────

model Pagamento {
  id          String          @id @default(uuid())
  pacienteId  String          @map("paciente_id")
  valor       Decimal         @db.Decimal(10, 2)
  metodo      MetodoPagamento
  status      StatusPagamento @default(PENDENTE)
  gatewayId   String?         @map("gateway_id")
  pagoEm      DateTime?       @map("pago_em")
  criadoEm    DateTime        @default(now()) @map("criado_em")

  paciente    Paciente     @relation(fields: [pacienteId], references: [id])
  agendamento Agendamento?

  @@map("pagamentos")
}

model Notificacao {
  id              String            @id @default(uuid())
  usuarioId       String            @map("usuario_id")
  agendamentoId   String?           @map("agendamento_id")
  tipo            String
  canal           CanalNotificacao
  status          StatusNotificacao @default(AGENDADA)
  agendadoPara    DateTime          @map("agendado_para")
  enviadoEm       DateTime?         @map("enviado_em")

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  agendamento Agendamento? @relation(fields: [agendamentoId], references: [id])

  @@map("notificacoes")
}

model Avaliacao {
  id              String   @id @default(uuid())
  agendamentoId   String   @unique @map("agendamento_id")
  pacienteId      String   @map("paciente_id")
  profissionalId  String   @map("profissional_id")
  nota            Int      // 1 a 5
  comentario      String?
  criadoEm        DateTime @default(now()) @map("criado_em")

  agendamento  Agendamento  @relation(fields: [agendamentoId], references: [id])
  paciente     Paciente     @relation(fields: [pacienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])

  @@map("avaliacoes")
}
